<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Barvy -->
    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="#121212"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#FF212121"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFF2F2F2"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#444444"/>
    <SolidColorBrush x:Key="GridSplitterBrush" Color="#FF3E3E3E"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FFA6A6A6"/>
    <SolidColorBrush x:Key="GreenTextBrush" Color="#FFE3FF85"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#777"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="MenuClickedBrush" Color="#FF654AF9"/>
    <SolidColorBrush x:Key="SliderBackgroundBrush" Color="#404040"/>
    <SolidColorBrush x:Key="SliderForegroundBrush" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="SliderHoverBrush" Color="#FF4B36BE"/>
    <Color x:Key="VolumeGradientStopFirst">#FF25BA23</Color>
    <Color x:Key="VolumeGradientStopSecond">#FF5CD93F</Color>
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#AD454545"/>
    <SolidColorBrush x:Key="ScrollBarHoverBrush" Color="#59475FDA"/>
    <SolidColorBrush x:Key="ScrollBarTrackBackgroundBrush" Color="#D32C2C2C"/>
    <SolidColorBrush x:Key="ScrollBarTrackBackgroundHoverBrush" Color="#D3313131"/>
    <SolidColorBrush x:Key="ComboBoxItemClickedBrush" Color="#7F3E3CD2"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#B73677E9"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#54E25050"/>
    <SolidColorBrush x:Key="ButtonClickedBrush" Color="#635840D4"/>
    <SolidColorBrush x:Key="SliderEqualizerThumbColor" Color="#FFD4D4D4"/>
    <Color x:Key="SelectedItemStopFirst">#3FA04ED1</Color>
    <Color x:Key="SelectedItemStopSecond">#59654AF9</Color>
    <Color x:Key="HoveredItemStopFirst">#1E544DED</Color>
    <Color x:Key="HoveredItemStopSecond">#267C93E9</Color>
    <Color x:Key="EqualizerGradientStopFirst">#FF342295</Color>
    <Color x:Key="EqualizerGradientStopSecond">#FF7763DC</Color>

    <!-- Obrázky/Ikony -->
    <ImageSource x:Key="IconPrev">pack://application:,,,/Resources/Obrazky/Ikona_Predchozi.png</ImageSource>
    <ImageSource x:Key="IconPlay">pack://application:,,,/Resources/Obrazky/Ikona_Prehrat.png</ImageSource>
    <ImageSource x:Key="IconPause">pack://application:,,,/Resources/Obrazky/Ikona_Pozastavit.png</ImageSource>
    <ImageSource x:Key="IconNext">pack://application:,,,/Resources/Obrazky/Ikona_Dalsi.png</ImageSource>
    <ImageSource x:Key="VolumeFrame1">pack://application:,,,/Resources/Obrazky/Ikona_Hlasitost_Frame_1.png</ImageSource>
    <ImageSource x:Key="VolumeFrame2">pack://application:,,,/Resources/Obrazky/Ikona_Hlasitost_Frame_2.png</ImageSource>
    <ImageSource x:Key="VolumeFrame3">pack://application:,,,/Resources/Obrazky/Ikona_Hlasitost_Frame_3.png</ImageSource>
    <ImageSource x:Key="VolumeFrame4">pack://application:,,,/Resources/Obrazky/Ikona_Hlasitost_Frame_4.png</ImageSource>
    <ImageSource x:Key="VolumeFrame5">pack://application:,,,/Resources/Obrazky/Ikona_Hlasitost_Frame_5.png</ImageSource>
    <ImageSource x:Key="IconArrow">pack://application:,,,/Resources/Obrazky/Ikona_Sipka.png</ImageSource>
    <ImageSource x:Key="IconFolder">pack://application:,,,/Resources/Obrazky/Ikona_Slozka.png</ImageSource>

</ResourceDictionary>
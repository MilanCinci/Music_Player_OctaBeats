<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Barvy -->
    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="#FFF6F6F6"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#FFEDEDED"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#000000"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="GridSplitterBrush" Color="#FFBEBEBE"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="Gray"/>
    <SolidColorBrush x:Key="GreenTextBrush" Color="#FF6AA620"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#999"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#99DFDFDF"/>
    <SolidColorBrush x:Key="MenuClickedBrush" Color="#FF4D36C6"/>
    <SolidColorBrush x:Key="SliderBackgroundBrush" Color="#FFC0BBBB"/>
    <SolidColorBrush x:Key="SliderForegroundBrush" Color="#FF545454"/>
    <SolidColorBrush x:Key="SliderHoverBrush" Color="#FF8098F9"/>
    <Color x:Key="VolumeGradientStopFirst">#FF63CF49</Color>
    <Color x:Key="VolumeGradientStopSecond">#FF6DE551</Color>
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#66C6C4C4"/>
    <SolidColorBrush x:Key="ScrollBarHoverBrush" Color="#3F374EC3"/>
    <SolidColorBrush x:Key="ScrollBarTrackBackgroundBrush" Color="#5BD9D9D9"/>
    <SolidColorBrush x:Key="ScrollBarTrackBackgroundHoverBrush" Color="#7AD9D9D9"/>
    <SolidColorBrush x:Key="ComboBoxItemClickedBrush" Color="#9E2C52CE"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#B74F88FA"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFFCE0E0"/>
    <SolidColorBrush x:Key="ButtonClickedBrush" Color="#C6624CD4"/>
    <Color x:Key="SelectedItemStopFirst">#34A34DD6</Color>
    <Color x:Key="SelectedItemStopSecond">#635840D4</Color>
    <Color x:Key="HoveredItemStopFirst">#2D445EBD</Color>
    <Color x:Key="HoveredItemStopSecond">#35445DBD</Color>

    <!-- Obrázky/Ikony -->
    <ImageSource x:Key="IconPrev">pack://application:,,,/Resources/Obrazky/Ikona_Predchozi_Dark.png</ImageSource>
    <ImageSource x:Key="IconPlay">pack://application:,,,/Resources/Obrazky/Ikona_Prehrat_Dark.png</ImageSource>
    <ImageSource x:Key="IconPause">pack://application:,,,/Resources/Obrazky/Ikona_Pozastavit_Dark.png</ImageSource>
    <ImageSource x:Key="IconNext">pack://application:,,,/Resources/Obrazky/Ikona_Dalsi_Dark.png</ImageSource>
    <ImageSource x:Key="VolumeFrame1">pack://application:,,,/Resources/Obrazky/Ikona_Hlasitost_Frame_1_Dark.png</ImageSource>
    <ImageSource x:Key="VolumeFrame2">pack://application:,,,/Resources/Obrazky/Ikona_Hlasitost_Frame_2_Dark.png</ImageSource>
    <ImageSource x:Key="VolumeFrame3">pack://application:,,,/Resources/Obrazky/Ikona_Hlasitost_Frame_3_Dark.png</ImageSource>
    <ImageSource x:Key="VolumeFrame4">pack://application:,,,/Resources/Obrazky/Ikona_Hlasitost_Frame_4_Dark.png</ImageSource>
    <ImageSource x:Key="VolumeFrame5">pack://application:,,,/Resources/Obrazky/Ikona_Hlasitost_Frame_5_Dark.png</ImageSource>
    <ImageSource x:Key="IconArrow">pack://application:,,,/Resources/Obrazky/Ikona_Sipka_Dark.png</ImageSource>
    <ImageSource x:Key="IconFolder">pack://application:,,,/Resources/Obrazky/Ikona_Slozka_Dark.png</ImageSource>

</ResourceDictionary>
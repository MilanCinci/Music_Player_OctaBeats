<Window x:Class="Hudebni_Prehravac_OctaBeats.Views.EkvalizerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hudebni_Prehravac_OctaBeats.Views"
        mc:Ignorable="d"
        Title="{Binding [Equalizer]}"
        Width="850" Height="600" 
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PrimaryBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStyle="ThreeDBorderWindow"
        MinWidth="800" MinHeight="500" Icon="/Resources/Obrazky/Ikona_Ekvalizer.ico">
    <Border Margin="15">

        <Grid Margin="25">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Nadpis -->
            <DockPanel Margin="0,0,0,25">

                <TextBlock Text="{Binding [Equalizer]}"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           VerticalAlignment="Center"/>

                <!-- Checkbox povolený ekvalizér -->
                <CheckBox Content="{Binding [Enabled]}"
                          Style="{StaticResource ModernCheckBox}"
                          IsChecked="{Binding JeEkvalizerZapnuty}"
                          VerticalAlignment="Center"
                          FontSize="12"
                          Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Right" Margin="0,0,20,0"/>
            </DockPanel>

            <Border Grid.Row="1"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="4,14,14,14">

                <!-- Hlavní ovládací panel -->
                <Grid IsEnabled="{Binding JeEkvalizerZapnuty}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Opacity" Value="1.0"/>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Číselná stupnice -->
                    <Grid Grid.Column="0" Margin="0,2,10,2">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">

                            <!-- Svislá vodicí čára -->
                            <Rectangle Width="2.5"
                                       Fill="{DynamicResource BorderBrush}" 
                                       HorizontalAlignment="Right"/>

                            <!-- Horní mez: +12 -->
                            <StackPanel Orientation="Horizontal" 
                                        HorizontalAlignment="Right" 
                                        VerticalAlignment="Top" Margin="0,-7,0,0">
                                <TextBlock Text="+12" 
                                           FontSize="12" 
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryTextBrush}" 
                                           VerticalAlignment="Center" 
                                           Margin="0,0,6,0"/>
                                <Rectangle Width="6" Height="1.5" 
                                           Fill="{DynamicResource SecondaryTextBrush}" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Střední mez: 0 -->
                            <StackPanel Orientation="Horizontal" 
                                        HorizontalAlignment="Right" 
                                        VerticalAlignment="Center">
                                <TextBlock Text="0" 
                                           FontSize="12" 
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryTextBrush}" 
                                           VerticalAlignment="Center" 
                                           Margin="0,0,6,0"/>
                                <Rectangle Width="6" Height="1.5" 
                                           Fill="{DynamicResource SecondaryTextBrush}" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Dolní mez: -12 -->
                            <StackPanel Orientation="Horizontal" 
                                        HorizontalAlignment="Right" 
                                        VerticalAlignment="Bottom" 
                                        Margin="0,0,0,-7">
                                <TextBlock Text="-12" 
                                           FontSize="12" 
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryTextBrush}" 
                                           VerticalAlignment="Center" 
                                           Margin="0,0,6,0"/>
                                <Rectangle Width="6" Height="1.5" 
                                           Fill="{DynamicResource SecondaryTextBrush}" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Prázdné texty pro zachování přesné mřížky podle pravé strany -->
                        <TextBlock Grid.Row="1" Text=" " Margin="0,18,0,0"/>
                        <TextBlock Grid.Row="2" Text=" " Margin="0,6,0,0"/>
                    </Grid>

                    <!-- Slidery pásem -->
                    <ItemsControl Grid.Column="1"
                                  ItemsSource="{Binding PasmaEkvalizeru}"
                                  IsEnabled="{Binding JeEkvalizerZapnuty}">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="10"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2,4,2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Slider konkrétního pásma -->
                                    <Slider Grid.Row="0"
                                            Style="{StaticResource SliderStyleEqualizer}"
                                            Minimum="-12"
                                            Maximum="12"
                                            VerticalAlignment="Stretch"
                                            Value="{Binding Zesileni,
                                                            Mode=TwoWay,
                                                            UpdateSourceTrigger=PropertyChanged}"
                                            ValueChanged="Slider_ValueChanged"/>

                                    <!-- Název pásma -->
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Nazev}"
                                               HorizontalAlignment="Center"
                                               Margin="0,18,0,0"
                                               FontWeight="SemiBold" 
                                               FontSize="12"/>

                                    <!-- Aktuální hodnota pásma (v dB) -->
                                    <TextBlock Grid.Row="2"
                                               Text="{Binding Zesileni, StringFormat={}{0:0.# dB}}"
                                               HorizontalAlignment="Center" 
                                               Margin="0,6,0,0" 
                                               FontSize="12"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Spodní část -->
            <Grid Grid.Row="2"
                  Margin="0,25,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">

                    <!-- Přednastavení (Preset) -->
                    <TextBlock Text="{Binding [Preset]}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <!-- ComboBox s přednastaveními (presety) -->
                    <ComboBox Width="180"
                              MinWidth="120"
                              Height="28"
                              Style="{StaticResource ModernComboBox}"
                              ItemsSource="{Binding TypyPrednastaveni}"
                              SelectedValue="{Binding VybranyTypPrednastaveni}"
                              IsEnabled="{Binding JeEkvalizerZapnuty}"
                              SelectedValuePath="Key"
                              DisplayMemberPath="Value">
                    </ComboBox>

                </StackPanel>

                <!-- Tlačítka -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">

                    <!-- Tlačítko Reset -->
                    <Button Content="{Binding [Reset]}"
                            Style="{StaticResource AppButtonStyle}"
                            Width="105" 
                            Height="28"
                            Margin="0,0,20,0"
                            Command="{Binding ResetCommand}"/>

                    <!-- Tlačítko Uložit -->
                    <Button Content="{Binding [Save]}"
                            Style="{StaticResource AppButtonStyle}"
                            Width="105" 
                            Height="28"
                            Command="{Binding UlozitCommand}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

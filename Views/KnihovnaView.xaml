<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:typyVyhledavani="clr-namespace:Hudebni_Prehravac_OctaBeats.Models"
             xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="Hudebni_Prehravac_OctaBeats.Views.KnihovnaView"
             xmlns:conv="clr-namespace:Hudebni_Prehravac_OctaBeats.Models.Conventers"
             MinWidth="200" 
             MinHeight="200">

    <UserControl.Resources>
        <conv:NullToBoolConverter x:Key="NullToBoolConverter"/>
        <conv:ByteToImageConverter x:Key="ByteToImageConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="0,0,0,10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- TextBox pro vyhledávání -->
            <TextBox Grid.Column="0"
                     MinWidth="120"
                     Height="28"
                     Margin="0,0,8,0"
                     Text="{Binding VyhledavanyText, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding VybranyPlaylist, Converter={StaticResource NullToBoolConverter}}"
                     Background="Transparent"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     BorderBrush="{DynamicResource BorderBrush}"
                     ToolTip="{Binding [Search]}" VerticalContentAlignment="Center" SelectionBrush="#FFE3FF85"/>

            <!-- Typ vyhledávání combobox -->
            <ComboBox Grid.Column="1"
                      MinWidth="120"
                      Height="28"
                      BorderBrush="{DynamicResource BorderBrush}"
                      ItemsSource="{Binding TypyVyhledavani}"
                      SelectedValue="{Binding VybranyTypVyhledavani}"
                      SelectedValuePath="Key"
                      DisplayMemberPath="Value"
                      IsEnabled="{Binding VybranyPlaylist, Converter={StaticResource NullToBoolConverter}}" VerticalContentAlignment="Center">
            </ComboBox>
        </Grid>

        <!-- Seznam skladeb -->
        <ListBox x:Name="listboxSongs" Grid.Row="1"
                 ItemsSource="{Binding VyfiltrovaneSkladby}"
                 SelectedItem="{Binding VybranaSkladba}"
                 Background="Transparent"
                 BorderBrush="{DynamicResource BorderBrush}"
                 HorizontalContentAlignment="Stretch" av:ItemsSource="{av:SampleData ItemCount=5}" VerticalContentAlignment="Center" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" PreviewMouseDown="ListBox_PreviewMouseDown" SelectionChanged="ListBox_SelectionChanged" MouseDoubleClick="ListBox_MouseDoubleClick">

            <!-- ContextMenu nad ListboxItem -->
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Tag" Value="{Binding RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <MenuItem Header="{Binding PlacementTarget.Tag.DataContext[ShowDetails], RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                        Command="{Binding PlacementTarget.Tag.DataContext.EditMetadataCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                        CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="📝" VerticalAlignment="Center"/>
                                    </MenuItem.Icon>
                                </MenuItem>

                                <Separator />

                                <MenuItem Header="{Binding PlacementTarget.Tag.DataContext[RemoveSong], RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                        Command="{Binding PlacementTarget.Tag.DataContext.RemoveSongCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                        CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="🗑️" VerticalAlignment="Center"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Přebal alba -->
                        <Border Grid.Column="0" Width="44" Height="44" Margin="0,0,14,0" CornerRadius="4">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding PrebalAlba, Converter={StaticResource ByteToImageConverter}, 
                                    TargetNullValue='pack://application:,,,/Resources/Obrazky/Ikona_Error_Image.png', 
                                    FallbackValue='pack://application:,,,/Resources/Obrazky/Ikona_Error_Image.png'}"
                                Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>

                        <!-- Název, Interpret a Album -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Nazev}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="{Binding Interpret}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding Album}" FontSize="11" FontStyle="Italic" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
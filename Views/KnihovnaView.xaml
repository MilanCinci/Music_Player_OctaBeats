<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:typyVyhledavani="clr-namespace:Hudebni_Prehravac_OctaBeats.Models"
             xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="Hudebni_Prehravac_OctaBeats.Views.KnihovnaView"
             xmlns:conv="clr-namespace:Hudebni_Prehravac_OctaBeats.Models.Conventers"
             MinWidth="200" 
             MinHeight="200">

    <UserControl.Resources>
        <conv:NullToBoolConverter x:Key="NullToBoolConverter"/>
        <conv:ByteToImageConverter x:Key="ByteToImageConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 🔍 VYHLEDÁVÁNÍ -->
        <Grid Grid.Row="0"
              Margin="0,0,0,10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- TextBox se přizpůsobí -->
            <TextBox Grid.Column="0"
                     MinWidth="120"
                     Height="28"
                     Margin="0,0,8,0"
                     Text="{Binding VyhledavanyText, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding VybranyPlaylist, Converter={StaticResource NullToBoolConverter}}"
                     ToolTip="Vyhledávání"/>

            <!-- ComboBox má minimální šířku -->
            <ComboBox Grid.Column="1"
                      MinWidth="120"
                      Height="28"
                      SelectedValue="{Binding VybranyTypVyhledavani}"
                      SelectedValuePath="Tag"
                      IsEnabled="{Binding VybranyPlaylist, Converter={StaticResource NullToBoolConverter}}">

                <ComboBoxItem Content="Název"
                              Tag="{x:Static typyVyhledavani:TypVyhledavani.Nazev}"/>

                <ComboBoxItem Content="Interpret"
                              Tag="{x:Static typyVyhledavani:TypVyhledavani.Interpret}"/>
            </ComboBox>
        </Grid>

        <!-- 🎵 SEZNAM SKLADEB -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding VyfiltrovaneSkladby}"
                 SelectedItem="{Binding VybranaSkladba}"
                 HorizontalContentAlignment="Stretch" av:ItemsSource="{av:SampleData ItemCount=5}" VerticalContentAlignment="Center" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" PreviewMouseDown="ListBox_PreviewMouseDown">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="44" Height="44" Margin="0,0,14,0" CornerRadius="4">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding PrebalAlba, Converter={StaticResource ByteToImageConverter}, 
                                    TargetNullValue='pack://application:,,,/Resources/Obrazky/Ikona_Error_Image.png', 
                                    FallbackValue='pack://application:,,,/Resources/Obrazky/Ikona_Error_Image.png'}"
                                Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Nazev}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{Binding Interpret}" Foreground="Gray" FontSize="11"/>
                            <TextBlock Text="{Binding Album}" Foreground="Gray" FontSize="11" FontStyle="Italic"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>

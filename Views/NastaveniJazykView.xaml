<Window x:Class="Hudebni_Prehravac_OctaBeats.Views.NastaveniJazykView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding [Settings]}" 
        Height="280" Width="420"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A1A"
        Foreground="White" MinHeight="220" MinWidth="360" MaxWidth="420" MaxHeight="280">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding [Language]}" 
               FontSize="20" FontWeight="Bold" Margin="0,5,0,20" Foreground="#FFE3FF85"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">

            <ComboBox ItemsSource="{Binding DostupneJazyky}"
                  SelectedItem="{Binding VybranyJazyk}"
                  DisplayMemberPath="Nazev"
                  Height="36" 
                  VerticalContentAlignment="Center" Margin="10,0,10,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="OK" 
                Command="{Binding PotvrditCommand}"
                Width="90" Height="32"
                IsDefault="True"
                Background="#333" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
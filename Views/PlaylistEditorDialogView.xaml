<Window x:Class="Hudebni_Prehravac_OctaBeats.Views.PlaylistEditorDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Úprava playlistu"
        Width="800"
        Height="500"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="9*"/>
            <RowDefinition Height="1.5*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 📚 KNIHOVNA -->
        <GroupBox Header="Knihovna" FontSize="18" FontWeight="Bold">
            <ListBox ItemsSource="{Binding KnihovnaSkladby}"
                     SelectedItem="{Binding VybranaKnihovnaSkladba}"
                     DisplayMemberPath="Nazev" FontSize="14" FontWeight="Normal"/>
        </GroupBox>

        <!-- ➕ / ➖ -->
        <StackPanel Grid.Column="1"
                    VerticalAlignment="Center"
                    Margin="12">
            <Button Content="➕"
                    Command="{Binding PridatCommand}"
                    Width="60"
                    Margin="0,5" FontSize="16"/>
            <Button Content="➖"
                    Command="{Binding OdebratCommand}"
                    Width="60"
                    Margin="0,5" FontSize="16"/>
        </StackPanel>

        <!-- Playlist -->
        <GroupBox Grid.Column="2"
                  Header="Playlist" FontSize="18" FontWeight="Bold">
            <ListBox ItemsSource="{Binding PlaylistSkladby}"
                     SelectedItem="{Binding VybranaPlaylistSkladba}"
                     DisplayMemberPath="Nazev" FontSize="14" FontWeight="Normal"/>
        </GroupBox>

        <!-- Název playlistu -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Název playlistu: " HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
        <TextBox x:Name="tboxPlaylist" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="40,0,40,0" FontSize="14"
                 Text="{Binding NazevPlaylistu, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Přidat a Odebrat -->
        <StackPanel Orientation="Horizontal" Grid.Column="2" Grid.Row="2" HorizontalAlignment="Right">
            <Button Content="OK"
                    Width="100"
                    Margin="5,8,30,8"
                    Command="{Binding PotvrditCommand}" FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>

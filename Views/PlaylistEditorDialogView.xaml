<Window x:Class="Hudebni_Prehravac_OctaBeats.Views.PlaylistEditorDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        mc:Ignorable="av" 
        Title="{Binding [PlaylistEditorTitle]}"
        Width="850" Height="600" 
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PrimaryBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStyle="ThreeDBorderWindow"
        MinWidth="800" MinHeight="500" Icon="/Resources/Obrazky/Ikona_Playlist_Editor.ico">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,0,0,20" Padding="0,0,0,18" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">

            <!-- Název playlistu -->
            <DockPanel>
                <TextBlock Text="{Binding [PlaylistName]}" 
                           VerticalAlignment="Center" 
                           FontSize="12" FontWeight="SemiBold" 
                           Margin="0,0,15,0"/>
                <TextBox x:Name="tboxPlaylist" 
                         Style="{StaticResource AppTextBox}" 
                         FontSize="12" Padding="8,5"
                         Text="{Binding NazevPlaylistu, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                         MaxWidth="400" HorizontalAlignment="Left"/>

                <!-- Checkbox kompaktní zobrazení -->
                <CheckBox Content="{Binding [CompactDisplay]}"
                    Style="{StaticResource ModernCheckBox}"
                    IsChecked="{Binding CompactMode}"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Right" Margin="0,0,20,0"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Nadpis knihovna -->
            <GroupBox Header="{Binding [Library]}" FontSize="16" FontWeight="SemiBold" 
                      BorderBrush="{DynamicResource BorderBrush}" Margin="10,0,10,10" Style="{StaticResource AppGroupBox}" Padding="0,0,0,0">

                <!-- Seznam skladeb v knihovně -->
                <ListBox x:Name="listKnihovna"
                         ItemsSource="{Binding KnihovnaSkladby}"
                         SelectedItem="{Binding VybranaKnihovnaSkladba}" 
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" av:ItemsSource="{av:SampleData ItemCount=5}" SelectionMode="Extended" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,6">
                                <Grid>

                                    <!-- normální režim zobrazení -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.CompactMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <!-- Název -->
                                        <TextBlock Text="{Binding Nazev}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>

                                        <!-- Interpret -->
                                        <TextBlock Text="{Binding Interpret}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                                        
                                        <!-- Album -->
                                        <TextBlock Text="{Binding Album}" FontSize="11" FontStyle="Italic" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>

                                    <!-- Kompaktní zobrazení -->
                                    <TextBlock FontSize="12" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.CompactMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>

                                        <Run Text="{Binding Nazev}"/>
                                        <Run Text=" – "/>
                                        <Run Text="{Binding Interpret}"/>
                                    </TextBlock>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">

                <!-- Tlačítko Přidat složku -->
                <Button Style="{StaticResource AddFolderButtonStyle}"
                        ToolTip="{Binding [ToolTipAddFolderToPlaylist]}"
                        Command="{Binding AddFolderCommand}"
                        Width="50" Height="40"
                        Margin="0,0,0,20">
                </Button>

                <!-- Tlačítko Přidat do playlistu -->
                <Button Style="{StaticResource AddButtonRightArrowStyle}"
                        ToolTip="{Binding [ToolTipAddToPlaylist]}"
                        Command="{Binding PridatCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=listKnihovna}"
                        Width="50" Height="40" FontSize="14"
                        Margin="0,0,0,20">
                </Button>

                <!-- Tlačítko Odebrat z playlistu -->
                <Button Style="{StaticResource RemoveButtonLeftArrowStyle}"
                     ToolTip="{Binding [ToolTipRemoveFromPlaylist]}"
                     Command="{Binding OdebratCommand}"
                     CommandParameter="{Binding SelectedItems, ElementName=listPlaylist}"   
                     Width="50" Height="40" FontSize="14"
                     Margin="0,0,0,20">
                </Button>
            </StackPanel>

            <!-- Nadpis playlist -->
            <GroupBox Grid.Column="2" Header="{Binding [Playlist]}" FontSize="16" FontWeight="SemiBold" 
                      BorderBrush="{DynamicResource BorderBrush}" Margin="10,0,10,10" Style="{StaticResource AppGroupBox}" Padding="0,0,0,0">
                <ListBox x:Name="listPlaylist"
                         ItemsSource="{Binding PlaylistSkladby}"
                         SelectedItem="{Binding VybranaPlaylistSkladba}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" av:ItemsSource="{av:SampleData ItemCount=5}" SelectionMode="Extended">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,6">
                                <Grid>

                                    <!-- normální režim zobrazení -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.CompactMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <!-- Název -->
                                        <TextBlock Text="{Binding Nazev}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>

                                        <!-- Interpret -->
                                        <TextBlock Text="{Binding Interpret}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>

                                        <!-- Album -->
                                        <TextBlock Text="{Binding Album}" FontSize="11" FontStyle="Italic" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>

                                    <!-- Kompaktní zobrazení -->
                                    <TextBlock FontSize="12" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.CompactMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>

                                            <Run Text="{Binding Nazev}"/>
                                            <Run Text=" – "/>
                                            <Run Text="{Binding Interpret}"/>
                                    </TextBlock>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
        </Grid>

        <!-- Tlačítko OK -->
        <Button Grid.Row="2" 
                Content="OK"
                Style="{StaticResource AppButtonStyle}"
                Width="105" Height="28"
                IsDefault="True"
                Margin="5,8,30,8"
                Command="{Binding PotvrditCommand}" 
                FontSize="12" HorizontalAlignment="Right" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
    </Grid>
</Window>
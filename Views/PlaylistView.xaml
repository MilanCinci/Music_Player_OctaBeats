<UserControl x:Class="Hudebni_Prehravac_OctaBeats.Views.PlaylistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:Hudebni_Prehravac_OctaBeats.Models.Conventers"
             mc:Ignorable="d"
             d:MinHeight="350"
             d:MinWidth="220">

    <UserControl.Resources>
        <conv:NullToBoolConverter x:Key="NullToBoolConverter"/>
        <conv:NullToVisibiltyConverter x:Key="NullToVisibilityConverter"/>
        <conv:SelectedToColorConverter x:Key="SelectedToColorConverter"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource PrimaryBackgroundBrush}"
                BorderThickness="1"
                Padding="2,5,2,5"
                Margin="0,0,0,0" CornerRadius="5,5,5,5">

            <DockPanel>

                <!-- Nadpis Playlisty -->
                <TextBlock Text="{Binding [Playlists]}"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontSize="20"
                           FontWeight="Bold"
                           DockPanel.Dock="Top"
                           Margin="10,0,10,10"/>

                <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Seznam playlistů -->
                    <ListBox Grid.Row="0" 
                             x:Name="lboxPlaylist" 
                             ItemsSource="{Binding Playlisty}" 
                             SelectedItem="{Binding VybranyPlaylist}"
                             MouseDoubleClick="ListBox_MouseDoubleClick"
                             Background="Transparent"
                             BorderThickness="0"
                             HorizontalContentAlignment="Stretch" 
                             d:ItemsSource="{d:SampleData ItemCount=5}" 
                             FontSize="13">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8" Margin="0,2">
                                    <TextBlock Text="{Binding Nazev}" 
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                               HorizontalAlignment="Left"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Název nového playlistu -->
                    <TextBox Grid.Row="1" Style="{StaticResource AppTextBox}"
                        Height="28"
                        Margin="5,5,5,16"                            
                        BorderBrush="{DynamicResource BorderBrush}"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        Text="{Binding NovyNazevPlaylistu,
                            UpdateSourceTrigger=PropertyChanged,
                            ValidatesOnDataErrors=True}"
                        ToolTip="{Binding [ToolTipEnterPlaylistName]}" VerticalContentAlignment="Center" Background="{x:Null}"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tlačítko Přidat -->
                        <Button Grid.Column="0"
                            Style="{StaticResource AddButtonStyle}"
                            Content="{Binding [Add]}"
                            Command="{Binding AddPlaylistCommand}"
                            Margin="5"/>

                        <!-- Tlačítko Odstranit -->
                        <Button
                            Style="{StaticResource RemoveButtonStyle}"
                            Grid.Column="1"
                            Content="{Binding [Delete]}"
                            Command="{Binding RemovePlaylistCommand}"
                            Margin="5"
                            IsEnabled="{Binding VybranyPlaylist, Converter={StaticResource NullToBoolConverter}, ConverterParameter=Inverse}"/>
                    </Grid>

                    <!-- Tlačítko Zobrazit knihovnu -->
                    <StackPanel Grid.Row="3">
                        <Button Content="{Binding [ShowLibrary]}" 
                            Style="{StaticResource AppButtonStyle}"
                            Command="{Binding ResetVyberCommand}"
                            Margin="5" 
                            Visibility="{Binding VybranyPlaylist, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </StackPanel>

                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

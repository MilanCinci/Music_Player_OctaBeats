<UserControl x:Class="Hudebni_Prehravac_OctaBeats.Views.PlaylistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:Hudebni_Prehravac_OctaBeats.Models.Conventers"
             mc:Ignorable="d"
             d:MinHeight="350"
             d:MinWidth="220">

    <UserControl.Resources>
        <conv:NullToBoolConverter x:Key="NullToBoolConverter"/>
        <conv:NullToVisibiltyConverter x:Key="NullToVisibilityConverter"/>
        <conv:SelectedToColorConverter x:Key="SelectedToColorConverter"/>
    </UserControl.Resources>
    
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        
        <Border Grid.Column="0"
                BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource PrimaryBackgroundBrush}"
                BorderThickness="1"
                Padding="5"
                Margin="0,0,0,0">

            <DockPanel>
                <TextBlock Text="{Binding [Playlists]}"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontSize="20"
                           FontWeight="Bold"
                           DockPanel.Dock="Top"
                           Margin="10,0,10,10"/>

                <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Seznam playlistů -->
                    <ListBox Grid.Row="0" 
                             x:Name="lboxPlaylist" 
                             ItemsSource="{Binding Playlisty}" 
                             SelectedItem="{Binding VybranyPlaylist}"
                             MouseDoubleClick="ListBox_MouseDoubleClick"
                             Background="Transparent"
                             BorderThickness="0"
                             HorizontalContentAlignment="Stretch" d:ItemsSource="{d:SampleData ItemCount=5}" 
                             FontSize="13">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" 
                    Margin="0,2,0,2" 
                    CornerRadius="0"
                    Background="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected, Converter={StaticResource SelectedToColorConverter}}">
                                    <TextBlock Text="{Binding Nazev}" 
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           HorizontalAlignment="Left"/>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Název nového playlistu -->
                    <TextBox Grid.Row="1"
                        Height="28"
                        Margin="0,0,0,16"
                        BorderBrush="{DynamicResource BorderBrush}"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        Text="{Binding NovyNazevPlaylistu,
                            UpdateSourceTrigger=PropertyChanged,
                            ValidatesOnDataErrors=True}"
                        ToolTip="Zadejte název nového playlistu" SelectionBrush="#FFE3FF85" VerticalContentAlignment="Center" Background="{x:Null}"/>
                   
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Tlačítko Přidat -->
                        <Button Grid.Column="0"
                            Content="{Binding [Add]}"
                            Command="{Binding AddPlaylistCommand}"
                            Margin="5"
                            Foreground="{DynamicResource PrimaryTextBrush}"/>

                        <!-- Tlačítko Odstranit -->
                        <Button Grid.Column="1"
                            Content="{Binding [Delete]}"
                            Command="{Binding RemovePlaylistCommand}"
                            Margin="5"
                            IsEnabled="{Binding VybranyPlaylist, Converter={StaticResource NullToBoolConverter}, ConverterParameter=Inverse}"
                            Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </Grid>

                    <!-- Tlačítko Zobrazit knihovnu -->
                    <StackPanel Grid.Row="3">
                        <Button Content="{Binding [ShowLibrary]}" 
                            Command="{Binding ResetVyberCommand}"
                            Margin="5" 
                            Background="{DynamicResource PrimaryBackgroundBrush}" 
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Visibility="{Binding VybranyPlaylist, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </StackPanel>

                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

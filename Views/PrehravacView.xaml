<UserControl x:Class="Hudebni_Prehravac_OctaBeats.Views.PrehravacView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="100">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ⏱ ČASOVÁ OSA -->
        <Grid Grid.Row="0" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>

            <!-- Aktuální čas -->
            <TextBlock Text="{Binding AktualniCasText}"
                   VerticalAlignment="Center"/>

            <!-- Slider -->
            <Slider Grid.Column="1"
                Minimum="0"
        Maximum="{Binding CelkovaDelka}"
        Value="{Binding AktualniCas, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        PreviewMouseLeftButtonDown="Slider_PreviewMouseLeftButtonDown"
        PreviewMouseUp="Slider_PreviewMouseUp"
        IsMoveToPointEnabled="True"/>

            <!-- Celkový čas -->
            <TextBlock Grid.Column="2"
                   Text="{Binding CelkovaDelkaText}"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"/>
        </Grid>

        <!-- ▶ OVLÁDÁNÍ -->
        <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Center">

            <Button Content="⏮"
                Command="{Binding PreviousCommand}"
                Width="60"/>

            <Button Content="▶"
                Command="{Binding PlayCommand}"
                Width="80"/>

            <Button Content="⏸"
                Command="{Binding PauseCommand}"
                Width="80"/>

            <Button Content="⏭"
                Command="{Binding NextCommand}"
                Width="60"/>
        </StackPanel>

    </Grid>


</UserControl>

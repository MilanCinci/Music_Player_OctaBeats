<UserControl x:Class="Hudebni_Prehravac_OctaBeats.Views.PrehravacView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Hudebni_Prehravac_OctaBeats.Models.Conventers"
             Height="190">

    <UserControl.Resources>
        <conv:VolumeRangeConverter x:Key="VolumeRangeConverter"/>
        <conv:NullToVisibiltyConverter x:Key="NullToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="106"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Přebal alba, Název, Interpret a Zdroj přehrávání -->
        <Grid Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Přebal alba -->
            <Border x:Name="borderImagePrebalAlba" Width="86" CornerRadius="8" BorderThickness="0" Grid.Column="0" Height="86">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding AktualniSkladba.PrebalAlba, 
                        TargetNullValue='pack://application:,,,/Resources/Obrazky/Ikona_Error_Image.png'}" 
                        Stretch="UniformToFill"/>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                </Border.Effect>
            </Border>

            <StackPanel VerticalAlignment="Center" Grid.Column="1" Margin="24,0,0,0">
                
                <!-- Název skladby -->
                <TextBlock x:Name="tblockNazev" Text="{Binding AktualniSkladba.Nazev}" 
                   Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" FontSize="16"/>

                <!-- Interpret -->
                <TextBlock x:Name="tblockInterpret" Text="{Binding AktualniSkladba.Interpret}" 
                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13"/>

                <!-- Zdroj přehrávání -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding AktualniSkladba, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Text="{Binding [Source]}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                    <TextBlock Text="{Binding ZdrojPrehravani}" Foreground="{DynamicResource GreenTextBrush}" FontSize="11"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Časová osa -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>

            <!-- Aktuální čas -->
            <TextBlock Text="{Binding AktualniCasText}"
                   VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>

            <!-- Slider skladby -->
            <Slider Grid.Column="1"
                    Minimum="0"
                    Maximum="{Binding CelkovaDelka}"
                    Value="{Binding AktualniCas, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource SliderStyleSong}"
                    PreviewMouseLeftButtonDown="Slider_PreviewMouseLeftButtonDown"
                    PreviewMouseUp="Slider_PreviewMouseUp"
                    IsMoveToPointEnabled="True"/>       

            <!-- Celkový čas -->
            <TextBlock Grid.Column="2"
                   Text="{Binding CelkovaDelkaText}"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right" Foreground="{DynamicResource PrimaryTextBrush}"/>
        </Grid>

        <!-- Ovládání -->
        <Grid Grid.Row="2" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Tlačítko Předchozí -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Command="{Binding PreviousCommand}" Style="{StaticResource ImageButtonStyle}" Margin="10,0">
                    <Image Source="{DynamicResource IconPrev}" Width="20" Height="20"/>
                </Button>

                <!-- Tlačítko Pauza/Přehrát -->
                <Button Margin="10,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ImageButtonStyle}">
                            <Setter Property="Command" Value="{Binding PlayCommand}"/>
                            <Setter Property="Content">
                                <Setter.Value>
                                    <Image Source="{DynamicResource IconPlay}" Width="20" Height="20"/>
                                </Setter.Value>
                            </Setter>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter Property="Command" Value="{Binding PauseCommand}"/>
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <Image Source="{DynamicResource IconPause}" Width="20" Height="20"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Tlačítko Další -->
                <Button Command="{Binding NextCommand}" Style="{StaticResource ImageButtonStyle}" Margin="10,0">
                    <Image Source="{DynamicResource IconNext}" Width="20" Height="20"/>
                </Button>
            </StackPanel>

            <!-- Ikona hlasitost -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                <Image Width="20" Height="20" Margin="0,0,8,0">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Source" Value="{DynamicResource VolumeFrame4}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Hlasitost, Converter={StaticResource VolumeRangeConverter}, ConverterParameter=1}" Value="True">
                                    <Setter Property="Source" Value="{DynamicResource VolumeFrame1}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Hlasitost, Converter={StaticResource VolumeRangeConverter}, ConverterParameter=2}" Value="True">
                                    <Setter Property="Source" Value="{DynamicResource VolumeFrame2}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Hlasitost, Converter={StaticResource VolumeRangeConverter}, ConverterParameter=3}" Value="True">
                                    <Setter Property="Source" Value="{DynamicResource VolumeFrame3}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Hlasitost, Converter={StaticResource VolumeRangeConverter}, ConverterParameter=5}" Value="True">
                                    <Setter Property="Source" Value="{DynamicResource VolumeFrame5}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>

                <!-- Slider hlasitosti -->
                <Slider Width="100" 
                Minimum="0" 
                Maximum="100" 
                Value="{Binding Hlasitost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                VerticalAlignment="Center"
                Margin="0,0,10,0"
                Style="{StaticResource SliderStyleVolume}"/>

                <!-- Aktuální hodnota hlasitosti -->
                <TextBlock Text="{Binding Hlasitost, StringFormat={}{0:0}%}" 
                   Foreground="{DynamicResource PrimaryTextBrush}" 
                   VerticalAlignment="Center" 
                   Width="35"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

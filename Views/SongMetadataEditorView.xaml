<Window x:Class="Hudebni_Prehravac_OctaBeats.Views.SongMetadataEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hudebni_Prehravac_OctaBeats.Views"
        xmlns:conv="clr-namespace:Hudebni_Prehravac_OctaBeats.Models.Conventers"
        mc:Ignorable="d"
        Title="{Binding [SongMetadataTitle]}"
        Width="650"
        Height="610"
        WindowStartupLocation="CenterOwner" MinWidth="650" MinHeight="610" MaxWidth="750" MaxHeight="680"
        Background="{DynamicResource PrimaryBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStyle="ThreeDBorderWindow" Icon="/Resources/Obrazky/Ikona_Metadata_Editor.ico">

    <Window.Resources>
        <conv:ByteToImageConverter x:Key="ByteToImageConverter"/>
    </Window.Resources>

    <Grid Margin="10,10,10,10">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>
        
        <!-- Tlačítko OK -->
        <StackPanel Orientation="Horizontal" Grid.Column="0" Grid.Row="1" HorizontalAlignment="Right">
            <Button Style="{StaticResource AppButtonStyle}" Content="OK"
            Width="105" 
            Height="28"
            Margin="5,8,30,8"
            Command="{Binding PotvrditCommand}" FontSize="12" TabIndex="6"/>
        </StackPanel>

        <Grid Grid.Column="0" Grid.Row="0" RenderTransformOrigin="0.496,0.54">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition Height="4*"/>
            </Grid.RowDefinitions>

            <!-- Název skladby -->
            <StackPanel Margin="15,5,15,8" VerticalAlignment="Center" Grid.Column="0" Grid.Row="0">
                <TextBlock Text="{Binding [Name]}" Margin="0,0,0,5" TextWrapping="WrapWithOverflow" TextTrimming="CharacterEllipsis" FontWeight="DemiBold"/>
                <TextBox Style="{StaticResource AppTextBox}" Text="{Binding Nazev, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" TabIndex="1" MaxLength="60" TextWrapping="WrapWithOverflow" Height="28" VerticalContentAlignment="Center"/>
            </StackPanel>

            <!-- Interpreti skladby -->
            <StackPanel Margin="15,5,15,5" VerticalAlignment="Center" Grid.Column="0" Grid.Row="1">
                <TextBlock Text="{Binding [Artist]}" Margin="0,0,0,5" TextWrapping="WrapWithOverflow" TextTrimming="CharacterEllipsis" FontWeight="DemiBold"/>
                <TextBox Style="{StaticResource AppTextBox}" Text="{Binding Interpret, UpdateSourceTrigger=PropertyChanged}" TabIndex="2" MaxLength="60" TextWrapping="WrapWithOverflow" Height="28" VerticalContentAlignment="Center"/>
            </StackPanel>

            <Grid Grid.Column="0" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Album -->
                <StackPanel Margin="15,5,15,5" VerticalAlignment="Center" Grid.Column="0" Grid.Row="0">
                    <TextBlock Text="{Binding [Album]}" Margin="0,0,0,5" TextWrapping="WrapWithOverflow" TextTrimming="CharacterEllipsis" FontWeight="DemiBold"/>
                    <TextBox Style="{StaticResource AppTextBox}" Text="{Binding Album, UpdateSourceTrigger=PropertyChanged}" TabIndex="3" MaxLength="80" TextWrapping="WrapWithOverflow" Height="28" VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Rok vydání -->
                <StackPanel Margin="15,5,15,5" VerticalAlignment="Center" Grid.Column="1" Grid.Row="0">
                    <TextBlock Text="{Binding [ReleaseYear]}" Margin="0,0,0,5" TextWrapping="WrapWithOverflow" TextTrimming="CharacterEllipsis" FontWeight="DemiBold"/>
                    <TextBox Style="{StaticResource AppTextBox}" Text="{Binding RokVydani, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" TabIndex="4" MaxLength="4" TextWrapping="WrapWithOverflow" Height="28" VerticalContentAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="0" Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Žánr -->
                <StackPanel Margin="15,5,15,5" VerticalAlignment="Center" Grid.Column="0" Grid.Row="0">
                    <TextBlock Text="{Binding [Genre]}" Margin="0,0,0,5" TextWrapping="WrapWithOverflow" TextTrimming="CharacterEllipsis" FontWeight="DemiBold"/>
                    <TextBox Style="{StaticResource AppTextBox}" Text="{Binding Zanr, UpdateSourceTrigger=PropertyChanged}" TabIndex="5" MaxLength="26" TextWrapping="WrapWithOverflow" Height="28" VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Délka -->
                <StackPanel Margin="15,5,15,5" VerticalAlignment="Center" Grid.Column="1" Grid.Row="0">
                    <TextBlock Text="{Binding [Duration]}" 
                       Margin="0,0,0,5" 
                       TextWrapping="WrapWithOverflow" 
                       TextTrimming="CharacterEllipsis" 
                       FontWeight="DemiBold"/>

                    <TextBlock Text="{Binding Delka, UpdateSourceTrigger=PropertyChanged}" 
                        Height="28" 
                        VerticalAlignment="Center"
                        Padding="0,5,0,0" 
                        TextWrapping="WrapWithOverflow" 
                        TextTrimming="CharacterEllipsis" 
                        FontWeight="DemiBold"/>
                </StackPanel>
            </Grid>

            <!-- Přebal alba -->
            <Grid Grid.Row="4" Margin="15,12,15,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
               Text="{Binding [AlbumCover]}" 
               Margin="0,0,0,5" 
               FontWeight="DemiBold"/>

                <Border Grid.Row="1" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="2"
                    Background="Transparent">

                    <!-- ContextMenu nad přebalem alba -->
                    <Border.ContextMenu>
                        <ContextMenu Style="{StaticResource ThemedContextMenu}">

                            <!-- MenuItem Uložit přebal alba -->
                            <MenuItem Style="{StaticResource ThemedMenuItem}" Header="{Binding [SaveAlbumCover]}" Command="{Binding StahnoutPrebalCommand}">
                                <MenuItem.Icon>
                                    <Image Source="/Resources/Obrazky/Ikona_Stahnout.png"
                                            Style="{StaticResource MenuItemIconStyle}"/>
                                </MenuItem.Icon>
                            </MenuItem>

                            <!-- MenuItem Vybrat nový přebal -->
                            <MenuItem Style="{StaticResource ThemedMenuItem}" Header="{Binding [ChooseAlbumCover]}" Command="{Binding VybratPrebalCommand}">
                                <MenuItem.Icon>
                                    <Image Source="/Resources/Obrazky/Ikona_Prebal_Obrazek.png"
                                            Style="{StaticResource MenuItemIconStyle}"/>
                                </MenuItem.Icon>
                            </MenuItem>

                            <!-- MenuItem Odstranit přebal alba -->
                            <MenuItem Style="{StaticResource ThemedMenuItem}" Header="{Binding [DeleteAlbumCover]}" Command="{Binding OdstranitPrebalCommand}">
                                <MenuItem.Icon>
                                    <Image Source="/Resources/Obrazky/Ikona_Vymazat_Vsechno.png"
                                            Style="{StaticResource MenuItemIconStyle}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Border.ContextMenu>

                    <Image Source="{Binding PrebalAlba, Converter={StaticResource ByteToImageConverter}, TargetNullValue='pack://application:,,,/Resources/Obrazky/Ikona_Error_Image.png'}"
                            Margin="5"
                            MaxWidth="300" 
                            MaxHeight="300"
                            Stretch="Uniform"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
